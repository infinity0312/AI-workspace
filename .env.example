# Local defaults work without a .env. Copy this file before configuring integrations.
AKW_PROFILE=local
AKW_PORT=4100
# DATABASE_URL=postgresql://akw:local_password@127.0.0.1:5433/akw
# AKW_TOKEN_SECRET=configure-a-random-secret-at-least-32-bytes
# AKW_TOKEN_ISSUER=akw
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# AKW_HARNESS_V2_ENABLED=false
# AKW_HARNESS_V2_WORKSPACES=
# AKW_HARNESS_V2_LOCAL_ALL=false
# AKW_HARNESS_V2_TOOLS=true
# AKW_HARNESS_V2_SKILLS=true
# AKW_HARNESS_V2_COMPACTION=true
# Optional private SSE message recovery. Use a durable, dedicated 32-byte hex key.
# AKW_RUNTIME_RECOVERY_KEY=
# BRAVE_SEARCH_API_KEY=
# AKW_PDF_FONT=C:/Windows/Fonts/simhei.ttf
# AKW_ALLOWED_ORIGINS=https://workspace.example.com
# AKW_S3_ENDPOINT=http://127.0.0.1:9000
# AKW_S3_BUCKET=akw
# AKW_S3_ACCESS_KEY=akw_local
# AKW_S3_SECRET_KEY=akw_local_password
# AKW_EMBEDDINGS_URL=
# AKW_EMBEDDINGS_MODEL=
# AKW_EMBEDDINGS_API_KEY=
