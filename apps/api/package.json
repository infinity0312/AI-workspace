{
  "name": "@akw/api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/apps/api/src/main.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "migrate": "tsx src/migrate.ts",
    "worker": "tsx src/worker/main.ts"
  },
  "dependencies": {
    "@akw/contracts": "*",
    "@aws-sdk/client-s3": "^3.940.0",
    "@electric-sql/pglite": "0.5.3",
    "@electric-sql/pglite-pgvector": "^0.0.4",
    "@napi-rs/canvas": "^0.1.80",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^9.15.3",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "htmlparser2": "^12.0.0",
    "image-size": "^2.1.0",
    "ipaddr.js": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "saxes": "^6.0.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.0",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.20.0"
  }
}
