    },
    {
      "id": "C15",
      "topic": "跨语种",
      "input": "中文检索英文固定资料",
      "expected": "可召回并关联覆盖项",
      "verification": "core:planned English facets"
    },
    {
      "id": "C16",
      "topic": "长摘录",
      "input": "长引用压缩与按需工具",
