      "verification": "harness:canary preserves evidence"
    },
    {
      "id": "C17",
      "topic": "重领",
      "input": "阶段中断后 lease 过期",
      "expected": "已完成起草不重复",
      "verification": "harness:canary preserves evidence"
    },
    {
      "id": "C18",
      "topic": "用户取消",
      "input": "等待中的流式模型",
      "expected": "取消传播且无晚到提案",
      "verification": "harness:canary cancellation"
    },
    {
      "id": "C19",
      "topic": "工具权限",
      "input": "陌生 evidence ID",
      "expected": "严格 schema 与 scope 拒绝",
      "verification": "harness:loop pairs authorized"
    },
    {
      "id": "C20",
      "topic": "提示注入面",
      "input": "网页隐藏或活动内容",
      "expected": "不进入可读正文",
      "verification": "core:web text drops hidden"
    },
    {
      "id": "C21",
      "topic": "PDF",
      "input": "文本页混合扫描页",
      "expected": "页码与 OCR 回归",
      "verification": "office:mixed PDF"
    },
    {
      "id": "C22",
      "topic": "表格与结构",
      "input": "Word、Slides、XLSX",
      "expected": "文本、顺序、单元格位置保留",
      "verification": "office:Office extraction"
    },
    {
      "id": "C23",
      "topic": "知识图谱和时间线",
      "input": "同一实体在多视图出现",
      "expected": "稳定 ID 和范围",
      "verification": "core:knowledge projections share canonical nodes"
    },
    {
      "id": "C24",
      "topic": "回滚与离线",
      "input": "关闭试点及重开文档",
      "expected": "新任务旧路径，已有事件仍可读",
      "verification": "harness:missing primary source"
    }
  ]
}
